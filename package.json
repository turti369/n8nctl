{
  "name": "@trngthnh369/n8nctl",
  "version": "0.0.0-development",
  "description": "CLI for managing n8n workflows via REST API — inspired by gh, kubectl.",
  "keywords": [
    "n8n",
    "cli",
    "automation",
    "workflow",
    "rest-api"
  ],
  "author": "Trường Thịnh <it01@emallvietnam.vn> (https://github.com/trngthnh369)",
  "license": "MIT",
  "homepage": "https://github.com/trngthnh369/n8nctl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trngthnh369/n8nctl.git"
  },
  "bugs": {
    "url": "https://github.com/trngthnh369/n8nctl/issues"
  },
  "type": "module",
  "bin": {
    "n8nctl": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node ./dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepack": "npm run build",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "handlebars": "^4.7.8",
    "inquirer": "^12.1.0",
    "js-yaml": "^4.1.0",
    "keytar": "^7.9.0",
    "node-jq": "^6.0.1",
    "ora": "^8.1.1",
    "table": "^6.8.2"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.2.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
